{
  "name": "img2umg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "extract": "node --import tsx src/cli/extract.ts",
    "validate": "node --import tsx src/cli/validate-package.ts",
    "check": "npm run test && npm run build",
    "v2:extract": "node --import tsx v2/src/cli.ts",
    "v2:typecheck": "tsc -p v2/tsconfig.json",
    "v2:test": "vitest run v2/tests"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "ajv": "^8.20.0",
    "css-tree": "^3.2.1",
    "parse5": "^8.0.1",
    "playwright-core": "^1.63.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
